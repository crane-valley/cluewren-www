---
import { strings, repo, docsUrl } from "../i18n";
import type { Locale } from "../i18n/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const quickStart = `git clone ${repo}.git
cd cluewren
dotnet build -c Release
./src/Cluewren/bin/Release/net10.0/cluewren connect claude`;
---

<main>
  <section class="hero">
    <h1>Cluewren</h1>
    <p class="lead">{t.hero.lead}</p>
    <p class="actions">
      <a class="button primary" href={docsUrl(locale)}>{t.hero.primary}</a>
      <a class="button" href={repo}>{t.hero.secondary}</a>
    </p>
    <ul class="engines">
      <li>Unity</li>
      <li>Godot</li>
      <li>Unreal Engine</li>
    </ul>
  </section>

  <section class="band">
    <h2>{t.steps.title}</h2>
    <ol class="steps">
      {t.steps.items.map((step) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="band">
    <h2>{t.features.title}</h2>
    <div class="grid">
      {t.features.items.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="band">
    <h2>{t.start.title}</h2>
    <p>{t.start.body}</p>
    <pre><code>{quickStart}</code></pre>
    <p><a href={docsUrl(locale)}>{t.start.more}</a></p>
  </section>
</main>
